# Fashion AI Video Generator - Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git - it contains sensitive keys

# ============================================================
# DATABASE CONFIGURATION (Required)
# ============================================================
# PostgreSQL connection string from Neon or your own database
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=xxxxxxxxxxxxxxxx

# ============================================================
# STRIPE API KEYS (Required for payments)
# ============================================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=xxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=xxxxxxxxxxxxxxxx

# Webhook signing secret from https://dashboard.stripe.com/webhooks
# Get this when you create a webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdefghijklmnop

# ============================================================
# FASHION.AI API KEY (Required for video generation)
# ============================================================
# Get from https://fashion.ai (contact their sales team)
FASHN_AI_API_KEY=fa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# EMAIL VERIFICATION (Optional)
# ============================================================
# Leave these blank/commented to skip email verification
# If you want to enable email verification, configure SMTP below

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=noreply@example.com
SMTP_SECURE=false

# Note for Gmail:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password (remove spaces when pasting)
# 4. Set SMTP_PASS to this password
# 5. Set SMTP_SECURE=false for port 587 (TLS)

# Alternative: SendGrid SMTP
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key
# SMTP_FROM=noreply@yourdomain.com
# SMTP_SECURE=false

# Alternative: Mailgun SMTP
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.mailgun.org
# SMTP_PASS=your_mailgun_password
# SMTP_FROM=noreply@your-domain.mailgun.org
# SMTP_SECURE=false

# ============================================================
# CORS CONFIGURATION (Optional)
# ============================================================
# Configure cross-origin resource sharing
# Default: * (allow all origins)
# For production, specify your domain: https://yourdomain.com
CORS_ORIGIN=*

# ============================================================
# NODE ENVIRONMENT (Optional)
# ============================================================
# development | production
# Usually set automatically by deployment platform
NODE_ENV=development

# ============================================================
# API CONFIGURATION (Optional)
# ============================================================
# Port for local development (Vite uses 5173 by default)
PORT=5173

# ============================================================
# DEPLOYMENT-SPECIFIC (Auto-set by platforms)
# ============================================================
# These are automatically set by deployment platforms:
# - VERCEL: Set by Vercel
# - NETLIFY: Set by Netlify
# - Do not manually set these unless self-hosting

# For Vercel
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-app.vercel.app

# For Netlify
# NETLIFY=true
# DEPLOY_URL=your-app.netlify.app

# ============================================================
# NOTES
# ============================================================
# 1. NEVER commit this file to git (should be in .gitignore)
# 2. Keep your .env file secure - it contains sensitive keys
# 3. Use strong, unique passwords/keys
# 4. Rotate keys regularly
# 5. Use different keys for development and production
# 6. In production, set variables via platform dashboard (Vercel/Netlify)
# 7. Test all endpoints after updating environment variables
# 8. Email verification (SMTP) is optional - leave blank to disable
