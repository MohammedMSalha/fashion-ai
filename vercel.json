{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/spa",
  "framework": "other",
  "nodeVersion": "22.x",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
