{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/spa",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
