{
  "buildCommand": "npm run build",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "dist/spa",
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "^/api/(.*?)/?$",
      "dest": "/api/[...path].ts",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"]
    },
    {
      "src": "/(.+)",
      "dest": "/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
