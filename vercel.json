{
  "buildCommand": "npm run build",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "dist/spa",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[[...pathname]]"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-video-status",
      "schedule": "*/2 * * * *"
    }
  ]
}
