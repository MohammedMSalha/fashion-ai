{
  "buildCommand": "npm run build",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "dist/spa",
  "functions": {
    "api/[[...pathname]].ts": {
      "runtime": "nodejs20.x",
      "memory": 3008,
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
