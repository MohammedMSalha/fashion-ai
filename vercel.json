{
  "buildCommand": "npm run build",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "dist/spa",
  "rewrites": [
    {
      "source": "^/api/(.*)$",
      "destination": "/api/$1"
    },
    {
      "source": "^(?!/api/).*$",
      "destination": "/index.html"
    }
  ]
}
